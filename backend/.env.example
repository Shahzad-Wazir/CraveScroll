PORT=3000
NODE_ENV=development

# MongoDB Atlas URI (use a dedicated database name like /cravescroll)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/cravescroll?retryWrites=true&w=majority

# Auth JWT settings
JWT_SECRET=replace_with_a_long_random_64_char_secret
JWT_EXPIRES_IN=7d

# Frontend URL(s) for CORS & CSRF origin validation (comma-separated for multiple origins)
CLIENT_URL=http://localhost:5173
ALLOWED_ORIGINS=http://localhost:5173

# Backend public URL (used by `npm run seed` for demo video URLs; set to Render URL in production)
BACKEND_URL=http://localhost:3000

# ImageKit credentials for cloud video & avatar uploads
IMAGEKIT_PUBLIC_KEY=
IMAGEKIT_PRIVATE_KEY=
IMAGEKIT_URL_ENDPOINT=

# Optional: Password for seeded demo accounts (only required if running `npm run seed`)
SEED_DEMO_PASSWORD=
